# Firebase web yapılandırması (Firebase Console > Proje ayarları > Web uygulaması)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA Enterprise site anahtarı
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug ayarları BURAYA DEĞİL, .env.development.local dosyasına yazılır (yalnızca npm run dev okur,
# üretim paketine girmez):
#   VITE_APPCHECK_DEBUG=true
#   VITE_APPCHECK_DEBUG_TOKEN=<UUID; Firebase Console > App Check > Debug token'lara ekle, GİZLİ tut>

# Firebase Emulator Suite'e bağlan (auth + firestore). AI çağrıları emülatörde yok, gerçek projeye gider.
VITE_USE_EMULATORS=false
